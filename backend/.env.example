# Copy to .env to override. Every value below is the default, so the app runs without a .env file.

PORT=3000

# Where product data comes from, and how long to wait for it (milliseconds).
FAKE_STORE_BASE_URL=https://fakestoreapi.com
FAKE_STORE_TIMEOUT_MS=5000

# Fake Store has no currency, so prices are shown in this one (ISO 4217).
CATALOGUE_CURRENCY=AUD

# The products chosen as "top rated" for the home page: comma-separated IDs, shown in this order.
FEATURED_PRODUCT_IDS=3,5,11,12,18
